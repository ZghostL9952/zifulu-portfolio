---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Runs at build time. Every non-draft study becomes a static HTML file.
export async function getStaticPaths() {
  const studies = await getCollection('work', ({ data }) => !data.draft);

  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const { title, summary, role, team, timeline, tools } = study.data;

const facts = [
  { label: 'Role', value: role },
  { label: 'Team', value: team },
  { label: 'Timeline', value: timeline },
  { label: 'Tools', value: tools.length ? tools.join(', ') : undefined },
].filter((fact) => fact.value);
---

<BaseLayout title={`${title} — Zifu Lu`} description={summary}>
  <article class="mx-auto max-w-2xl px-6 pt-16">
    <header>
      <h1 class="text-4xl m-0">{title}</h1>
      <p class="mt-5 text-lg text-ink-muted m-0">{summary}</p>

      <dl class="mt-8 pt-6 border-t border-line grid gap-x-6 gap-y-3 sm:grid-cols-[7rem_1fr] m-0">
        {
          facts.map((fact) => (
            <>
              <dt class="text-[0.875rem] text-ink-muted m-0">{fact.label}</dt>
              <dd class="text-[0.9375rem] m-0 ml-0">{fact.value}</dd>
            </>
          ))
        }
      </dl>
    </header>

    <div class="prose mt-12 pt-10 border-t border-line">
      <Content />
    </div>

    <p class="mt-16 mb-8">
      <a href="/#work" class="underline underline-offset-4">&larr; All work</a>
    </p>
  </article>
</BaseLayout>

<style>
  /* Markdown body styling. Hand-written instead of @tailwindcss/typography so the
     case studies inherit the palette exactly and add no dependency. Not scoped
     with :global on the wrapper alone -- Astro scopes these to this component,
     and `is(...)` reaches the Markdown elements rendered inside <Content />. */
  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 3rem 0 0.75rem;
  }

  .prose :global(h3) {
    font-size: 1.1875rem;
    margin: 2.25rem 0 0.5rem;
  }

  .prose :global(p) {
    margin: 0 0 1.125rem;
    color: var(--ink-muted);
  }

  /* Bold inside body copy is the emphasis mechanism -- weight, not hue,
     per the design direction. It steps up to full --ink. */
  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .prose :global(ul) {
    margin: 0 0 1.125rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--ink-muted);
  }

  .prose :global(li) {
    margin-bottom: 0.375rem;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 3rem 0;
  }

  .prose :global(em) {
    font-style: italic;
  }

  /* `margin-inline: auto` centers any image narrower than the column. The wide
     screenshots and charts already fill it, so this only shows up on small
     diagrams. */
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
  }

  /* The two-layer prompt diagram is a small portrait graphic -- at full column
     width it reads as an oversized placeholder. Astro keeps the source basename
     as the prefix of the hashed build filename (two-prompt-layers.NAiIHzgv…webp),
     which is what lets this match a specific image without an MDX dependency. */
  .prose :global(img[src*='two-prompt-layers']) {
    max-width: 280px;
  }
</style>
