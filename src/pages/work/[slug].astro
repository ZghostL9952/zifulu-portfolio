---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';

// Runs at build time. Every non-draft study becomes a static HTML file.
export async function getStaticPaths() {
  const studies = await getCollection('work', ({ data }) => !data.draft);

  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;

// `headings` is extracted from the markdown at build time, so the jump-to nav
// is generated from the document itself -- adding an h2 to the .md adds a link.
const { Content, headings } = await render(study);
const sections = headings.filter((heading) => heading.depth === 2);

const { title, summary, role, company, team, timeline, tools } = study.data;

// Role is rendered as tags, so it is handled separately from the plain-text rows.
const facts = [
  { label: 'Company', value: company },
  { label: 'Team', value: team },
  { label: 'Timeline', value: timeline },
  { label: 'Tools', value: tools.length ? tools.join(', ') : undefined },
].filter((fact) => fact.value);
---

<BaseLayout title={`${title} — Zifu Lu`} description={summary}>
  {/*
    Two-column grid on lg+: nav rail in column 1, text in column 2. Below lg it
    collapses to one column and the source order (header, contents, body) is
    already the right reading order, so nothing needs reordering.
  */}
  <div
    class="case-grid mx-auto grid max-w-6xl gap-x-12 px-6 pt-16 lg:grid-cols-[11rem_minmax(0,50rem)] lg:justify-center"
  >
    <header class="lg:col-start-2">
      <h1 class="m-0 text-4xl">{title}</h1>
      <p class="m-0 mt-5 text-lg text-ink-muted">{summary}</p>

      <dl class="m-0 mt-8 grid items-baseline gap-x-6 gap-y-3 border-t border-line pt-6 sm:grid-cols-[7rem_1fr]">
        <dt class="m-0 text-[0.875rem] text-ink-muted">Role</dt>
        <dd class="m-0 ml-0">
          <TagList items={role} />
        </dd>

        {
          facts.map((fact) => (
            <>
              <dt class="m-0 text-[0.875rem] text-ink-muted">{fact.label}</dt>
              <dd class="m-0 ml-0 text-[0.9375rem]">{fact.value}</dd>
            </>
          ))
        }
      </dl>
    </header>

    <nav
      aria-label="Sections of this case study"
      class="toc mt-12 border-t border-line pt-6 lg:col-start-1 lg:row-start-2 lg:mt-14 lg:self-start lg:border-t-0 lg:pt-0"
    >
      <p class="m-0 text-[0.75rem] font-medium uppercase tracking-[0.09em] text-ink-muted">
        Contents
      </p>

      <ol class="m-0 mt-3 list-none p-0">
        {
          sections.map((section, index) => (
            <li>
              <a class="toc-link" href={`#${section.slug}`} data-toc-link={section.slug}>
                <span class="toc-num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{section.text}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="prose mt-10 border-t border-line pt-10 lg:col-start-2 lg:row-start-2 lg:mt-14">
      <Content />
    </div>

    <p class="mb-8 mt-16 lg:col-start-2">
      <a href="/#work" class="underline underline-offset-4">&larr; All work</a>
    </p>
  </div>
</BaseLayout>

<style>
  /* ---------------------------------------------------------------------
     Jump-to rail
     --------------------------------------------------------------------- */

  /* `self-start` is what makes position:sticky work inside a grid row -- a
     stretched grid item is already as tall as its row, so it has nothing to
     stick within. */
  @media (min-width: 1024px) {
    .toc {
      position: sticky;
      top: 2rem;
    }
  }

  .toc-link {
    display: flex;
    gap: 0.625rem;
    /* 44px minimum tap target on touch, per CLAUDE.md. */
    min-height: 2.75rem;
    align-items: center;
    padding: 0.375rem 0 0.375rem 0.75rem;
    border-left: 2px solid transparent;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.35;
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .toc-link {
      min-height: 0;
      align-items: baseline;
    }
  }

  .toc-num {
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  /* Hover behavior must also fire on focus. */
  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--ink);
    border-left-color: var(--line);
  }

  /* Current section. Three simultaneous signals -- color, weight, and the
     border appearing -- because state is never signalled by color alone. */
  .toc-link[aria-current='true'] {
    color: var(--ink);
    font-weight: 500;
    border-left-color: var(--accent);
  }

  .toc-link[aria-current='true'] .toc-num {
    color: var(--accent);
  }

  /* ---------------------------------------------------------------------
     Markdown body

     Hand-written instead of @tailwindcss/typography so the case studies
     inherit the palette exactly and add no dependency. Astro scopes these to
     this component, and :global() reaches the elements <Content /> renders.
     --------------------------------------------------------------------- */

  .prose {
    counter-reset: section;
  }

  /* Section numbers come from a CSS counter rather than the markdown, so
     reordering sections in the .md renumbers them automatically. */
  .prose :global(h2) {
    counter-increment: section;
    margin: 4.5rem 0 1rem;
    border-top: 1px solid var(--line);
    padding-top: 3rem;
    font-size: 1.75rem;
    scroll-margin-top: 2rem;
  }

  .prose :global(h2)::before {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    color: var(--ink-muted);
  }

  /* The wrapper already draws a rule above the first section. */
  .prose > :global(h2:first-child) {
    margin-top: 0;
    border-top: 0;
    padding-top: 0;
  }

  .prose :global(h3) {
    margin: 2.75rem 0 0.625rem;
    font-size: 1.1875rem;
    scroll-margin-top: 2rem;
  }

  .prose :global(p) {
    margin: 0 0 1.125rem;
    color: var(--ink-muted);
  }

  /* A paragraph that is nothing but bold text is a thesis statement, not
     emphasis inside a sentence. `:has` lets those get display type and air
     while leaving mid-paragraph bold alone. */
  .prose :global(p:has(> strong:only-child)) {
    margin: 2.75rem 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }

  .prose :global(p:has(> strong:only-child) strong) {
    font-weight: 400;
    color: inherit;
  }

  /* Bold inside body copy is the emphasis mechanism -- weight, not hue. */
  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  /* Psychology insight card.

     Colours sampled from the reference: a flat #f7f7f7 fill with no border and
     no shadow, and #ff73b4 for the eyebrow. Corners are rounder than the
     original, as asked.

     A card is just a blockquote whose first line is the law name -- the eyebrow
     is generated, so it never has to be retyped. */
  /* Short lines, so the card is a tall rectangle rather than a wide one. At
     ~30 characters it matches the reference's measure while needing barely
     half the horizontal room -- which is what lets the margin treatment start
     at 1280px instead of 1440px. */
  .prose :global(blockquote) {
    margin: 1.75rem 0;
    max-width: 18rem;
    padding: 1.25rem 1.375rem 1.375rem;
    border: 0;
    border-radius: 18px;
    background-color: #f7f7f7;
    box-shadow: none;
  }

  /* ------------------------------------------------------------------
     Margin cards, 1280px and up.

     The float's own margins cancel out (18rem wide, +2 left, -20 right), so
     it occupies zero width in the flow -- body text does not wrap around it --
     while keeping its vertical position beside the passage it belongs to.
     `clear` stops two consecutive cards sharing a line.

     Budget: 79rem box less 3rem padding is 76rem. The grid takes
     11 + 3 gap + 41 = 55rem, leaving 21rem for a card needing 20rem.
     ------------------------------------------------------------------ */
  @media (min-width: 1280px) {
    .case-grid {
      max-width: 79rem;
      grid-template-columns: 11rem minmax(0, 41rem);
      justify-content: start;
    }

    .prose :global(blockquote) {
      float: right;
      clear: right;
      width: 18rem;
      max-width: none;
      margin-left: 2rem;
      margin-right: -20rem;
    }
  }

  /* Wide screens give the text column its full width back. */
  @media (min-width: 1600px) {
    .case-grid {
      max-width: 96rem;
      grid-template-columns: 11rem minmax(0, 50rem);
    }

    .prose :global(blockquote) {
      width: 20rem;
      margin-right: -22rem;
    }
  }

  /* Reveal. Gated on [data-cards], which the script sets, so with no
     JavaScript the attribute never appears and the cards simply stay put. */
  .prose[data-cards] :global(blockquote) {
    opacity: 0;
    transform: translateX(1.5rem);
    transition:
      opacity 380ms ease,
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .prose[data-cards] :global(blockquote[data-visible]) {
    opacity: 1;
    transform: none;
  }

  /* ------------------------------------------------------------------
     Below 1280px: tap the image, the card overlays it.

     The overlay element is built by the script, so these have to be global.
     A shadow appears only here -- over artwork the card needs to separate
     from what is behind it, which is not true in the margin.
     ------------------------------------------------------------------ */
  .prose :global(.has-cards) {
    position: relative;
    cursor: pointer;
  }

  .prose :global(.card-overlay) {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 220ms ease,
      visibility 220ms;
  }

  .prose :global([data-cards-open] > .card-overlay) {
    opacity: 1;
    visibility: visible;
  }

  .prose :global(.card-overlay blockquote) {
    width: 100%;
    max-width: 20rem;
    margin: 0;
    opacity: 1;
    transform: none;
    box-shadow: 0 6px 24px rgb(26 26 24 / 0.22);
  }

  /* The affordance, so an image that does something looks like it. */
  .prose :global(.has-cards)::after {
    content: '🧠';
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    z-index: 1;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: #f7f7f7;
    font-size: 0.875rem;
    line-height: 1.2;
    box-shadow: 0 2px 8px rgb(26 26 24 / 0.18);
  }

  .prose :global([data-cards-open])::after {
    opacity: 0;
  }

  .prose :global(.has-cards:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* CLAUDE.md: state changes instantly, no fades or transforms. */
  @media (prefers-reduced-motion: reduce) {
    .prose[data-cards] :global(blockquote),
    .prose[data-cards] :global(blockquote[data-visible]),
    .prose :global(.card-overlay) {
      transform: none;
      transition: none;
    }

    .prose[data-cards] :global(blockquote[data-visible]) {
      opacity: 1;
    }
  }

  .prose :global(blockquote)::before {
    content: '🧠 # Psychology Insights';
    display: block;
    margin-bottom: 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ff73b4;
  }

  .prose :global(blockquote p) {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* The law name. These two selectors are deliberately more specific than the
     thesis-statement rule above, which would otherwise catch a first line that
     is nothing but bold text and render it in Fraunces at 22px. */
  .prose :global(blockquote p:first-of-type),
  .prose :global(blockquote p:first-of-type:has(> strong:only-child)) {
    margin-bottom: 0.625rem;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  /* Same reason: the thesis rule drops its <strong> back to weight 400. */
  .prose :global(blockquote p:first-of-type strong) {
    font-weight: 700;
    color: var(--ink);
  }

  /* Before / after comparison.

     Raw <figure> wrappers with blank lines inside, so the images stay markdown
     and keep going through Astro's optimizer. Side by side from 768px, stacked
     below it -- two 384px panels compare far better than the 176px filmstrip
     these would otherwise fall into. */
  .prose :global(.compare) {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  @media (min-width: 768px) {
    .prose :global(.compare) {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem;
      align-items: start;
    }
  }

  .prose :global(.compare figure) {
    margin: 0;
  }

  .prose :global(.compare p) {
    margin: 0;
  }

  .prose :global(.compare img) {
    width: 100%;
    max-width: none;
    margin: 0;
    border-radius: 8px;
  }

  /* Overrides the centred caption used under standalone figures: these are
     labels above the image, not captions below it. */
  .prose :global(.compare figcaption) {
    margin: 0 0 0.625rem;
    text-align: left;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-muted);
  }

  .prose :global(ul) {
    margin: 0 0 1.125rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--ink-muted);
  }

  .prose :global(li) {
    margin-bottom: 0.375rem;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 3.5rem 0;
  }

  .prose :global(em) {
    font-style: italic;
  }

  /* `margin-inline: auto` centers any image narrower than the column. The wide
     screenshots and charts already fill it, so this only shows up on small
     diagrams. */
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.75rem auto;
  }

  /* The two-layer prompt diagram is a small portrait graphic -- at full column
     width it reads as an oversized placeholder. Astro keeps the source basename
     as the prefix of the hashed build filename (two-prompt-layers.NAiIHzgv…webp),
     which is what lets this match a specific image without an MDX dependency. */
  .prose :global(img[src*='two-prompt-layers']) {
    max-width: 280px;
  }

  /* The old sign-up screen is a phone capture like the ones in the filmstrip
     below it, so it matches their width instead of filling the column. Same
     width, not same height -- the source is a taller crop. */
  .prose :global(img[src*='old-screen']) {
    width: 11rem;
  }

  /* Split rows.

     Same convention as the filmstrip below: a blank line between text and an
     image keeps the image full width underneath, no blank line puts them in
     ONE paragraph and pairs them side by side. The rule reads as "a paragraph
     holding an image plus something else, but not a run of images."

     The image floats rather than the paragraph becoming a grid, deliberately.
     In a grid container every element child is its own grid item, so a single
     **bold** run inside the text would silently break the row into three
     columns. A float is immune to whatever inline markup the sentence has.
     `flow-root` makes the paragraph contain its own float so a short sentence
     cannot let the image overlap what comes next. */
  .prose :global(p:has(> img):not(:has(> img:only-child)):not(:has(img + img))) {
    display: flow-root;
    margin: 1.75rem 0;
  }

  @media (min-width: 900px) {
    .prose
      :global(p:has(> img):not(:has(> img:only-child)):not(:has(img + img)) > img) {
      float: right;
      width: 13rem;
      max-width: 40%;
      margin: 0.25rem 0 1rem 2.5rem;
      border-radius: 10px;
    }
  }

  /* Column layouts.

     Written as a raw <div> in the markdown with blank lines inside it, which is
     what lets CommonMark parse the contents as markdown rather than as one
     opaque HTML block. Safe here because these wrappers hold only text -- an
     <img> inside raw HTML would skip Astro's optimizer and ship a broken path.

     Each feature gets its own inner <div> so it is a single grid item. Without
     that, a heading and its paragraph are separate children and would land in
     different columns. */
  .prose :global(.cols-2),
  .prose :global(.with-media) {
    display: grid;
    gap: 1.5rem;
    margin: 1.75rem 0;
  }

  @media (min-width: 768px) {
    .prose :global(.cols-2) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  /* The third change is its own beat, separate from the pair above it and the
     composite screens in between, so it opens with noticeably more air. */
  .prose :global(.with-media) {
    margin-top: 4.5rem;
  }

  @media (min-width: 900px) {
    .prose :global(.with-media) {
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: 2.5rem;
      align-items: start;
    }
  }

  .prose :global(.cols-2 > div > *:first-child),
  .prose :global(.with-media > div > *:first-child) {
    margin-top: 0;
  }

  .prose :global(.cols-2 > div > *:last-child),
  .prose :global(.with-media > div > *:last-child) {
    margin-bottom: 0;
  }

  /* The standalone-figure rule centres and caps video width; in a media column
     it should simply fill the track. */
  .prose :global(.with-media figure) {
    margin: 0;
  }

  .prose :global(.with-media figure video) {
    width: 100%;
    max-width: none;
  }

  /* Filmstrip.

     Consecutive image lines in markdown with no blank line between them parse
     into ONE paragraph. That is the whole trick: a paragraph holding more than
     one image is a sequence, so it lays out as a horizontal strip. Writing the
     images normally in the .md keeps them in Astro's optimizer. */
  .prose :global(p:has(img + img)) {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    margin: 1.75rem 0;
    padding-bottom: 0.75rem;
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
  }

  .prose :global(p:has(img + img) img) {
    flex: none;
    width: 11rem;
    max-width: none;
    margin: 0;
    border-radius: 10px;
    scroll-snap-align: start;
  }

  /* The user-flow export is 8608px wide. Fitted to the text column it would be
     about 225px tall and completely unreadable, so it keeps a legible height
     and scrolls sideways instead. The script below makes the region focusable
     so it is reachable without a mouse. */
  .prose :global(p:has(> img[src*='user-flow'])) {
    overflow-x: auto;
    margin: 1.75rem 0;
    padding-bottom: 0.75rem;
    overscroll-behavior-x: contain;
  }

  .prose :global(img[src*='user-flow']) {
    height: 26rem;
    width: auto;
    max-width: none;
    margin: 0;
  }

  /* Any scrollable row that the script made focusable shows the standard ring. */
  .prose :global(p[tabindex]:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  /* Video, for screen recordings. Portrait phone capture, so it is capped and
     centred rather than filling the column. No autoplay -- it never moves until
     asked, which is also what keeps it safe under reduced motion. */
  .prose :global(figure) {
    margin: 2.25rem 0;
  }

  .prose :global(figure video) {
    display: block;
    width: 100%;
    max-width: 19rem;
    height: auto;
    margin: 0 auto;
    border-radius: 12px;
  }

  .prose :global(figcaption) {
    margin-top: 0.875rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.9375rem;
  }

  .prose :global(th) {
    text-align: left;
    font-weight: 500;
    color: var(--ink);
  }

  .prose :global(td) {
    color: var(--ink-muted);
  }

  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 0.625rem 1rem 0.625rem 0;
  }

  .prose :global(ol) {
    margin: 0 0 1.125rem;
    padding-left: 1.25rem;
    color: var(--ink-muted);
  }
</style>

<script>
  // Marks the section you are currently reading in the jump-to rail. Plain DOM,
  // no framework. If this never runs the rail still works as ordinary anchors.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));

  const targets = links
    .map((link) => {
      const id = link.dataset.tocLink;
      const heading = id ? document.getElementById(id) : null;
      return heading ? { link, heading } : null;
    })
    .filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry !== null);

  if (targets.length > 0) {
    let queued = false;

    const update = () => {
      queued = false;

      // The active section is the last one whose heading has passed the top
      // band of the viewport. Falls back to the first so something is always
      // marked before you have scrolled anywhere.
      let active = targets[0];
      for (const entry of targets) {
        if (entry.heading.getBoundingClientRect().top <= 120) active = entry;
      }

      for (const entry of targets) {
        if (entry === active) {
          entry.link.setAttribute('aria-current', 'true');
        } else {
          entry.link.removeAttribute('aria-current');
        }
      }
    };

    // rAF-throttled so a fast scroll does not run this on every event.
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    update();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
  }

  // A region you can only reach by dragging is unusable without a mouse, so any
  // row in the article that actually overflows becomes a focusable group. Done
  // here rather than in the markup because whether something overflows depends
  // on the viewport, not on the source.
  const markScrollable = () => {
    for (const row of document.querySelectorAll<HTMLElement>('.prose p')) {
      const overflows = row.scrollWidth > row.clientWidth + 1;

      if (overflows && !row.hasAttribute('tabindex')) {
        row.tabIndex = 0;
        row.setAttribute('role', 'group');
        row.setAttribute('aria-label', 'Scrollable images, use arrow keys');
      } else if (!overflows && row.hasAttribute('tabindex')) {
        row.removeAttribute('tabindex');
        row.removeAttribute('role');
        row.removeAttribute('aria-label');
      }
    }
  };

  markScrollable();
  addEventListener('resize', markScrollable, { passive: true });
  addEventListener('load', markScrollable);

  // Psychology cards.
  //
  // Wide screens: the card lives in the margin and appears only while its
  // passage is in the middle of the viewport, fading again once you scroll on.
  // Narrower screens: there is no margin to put it in, so the card overlays the
  // image it belongs to and is opened by tapping that image.
  //
  // Setting [data-cards] is what arms the hidden state, so a script that never
  // runs leaves every card visible rather than blank.
  const prose = document.querySelector<HTMLElement>('.prose');
  const cards = prose ? Array.from(prose.querySelectorAll<HTMLElement>(':scope > blockquote')) : [];

  if (prose && cards.length > 0) {
    prose.dataset.cards = '';

    // Where each card sits in the document, so it can be put back when the
    // layout crosses the breakpoint.
    const home = new Map(
      cards.map((card) => [card, { parent: card.parentNode!, next: card.nextSibling }])
    );

    /** The image this card belongs to: the nearest one in its own section. */
    const imageFor = (card: HTMLElement): HTMLElement | null => {
      for (const dir of ['nextElementSibling', 'previousElementSibling'] as const) {
        let node = card[dir] as HTMLElement | null;
        while (node) {
          // Never pair across a section boundary.
          if (node.tagName === 'H2') break;
          if (node.querySelector('img')) return node;
          node = node[dir] as HTMLElement | null;
        }
      }
      return null;
    };

    const wide = matchMedia('(min-width: 1280px)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    let observer: IntersectionObserver | null = null;
    let openHost: HTMLElement | null = null;
    const hosts: HTMLElement[] = [];

    const closeOpen = () => {
      if (!openHost) return;
      openHost.removeAttribute('data-cards-open');
      openHost.setAttribute('aria-expanded', 'false');
      openHost = null;
    };

    const teardown = () => {
      observer?.disconnect();
      observer = null;
      closeOpen();

      for (const host of hosts.splice(0)) {
        host.classList.remove('has-cards');
        host.removeAttribute('role');
        host.removeAttribute('tabindex');
        host.removeAttribute('aria-expanded');
        host.removeAttribute('aria-label');
        host.querySelector('.card-overlay')?.remove();
      }

      // Back to their document positions before the other mode takes over.
      for (const card of cards) {
        const spot = home.get(card)!;
        spot.parent.insertBefore(card, spot.next);
        card.removeAttribute('data-visible');
      }
    };

    const setupMargin = () => {
      // A band across the middle of the viewport: a card shows while its
      // passage is in the centre of vision, and hides once it has passed.
      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            entry.target.toggleAttribute('data-visible', entry.isIntersecting);
          }
        },
        { rootMargin: '-42% 0px -42% 0px', threshold: 0 }
      );

      for (const card of cards) observer.observe(card);
    };

    const setupOverlay = () => {
      // Several cards can belong to one image, so group before building.
      const grouped = new Map<HTMLElement, HTMLElement[]>();
      for (const card of cards) {
        const host = imageFor(card);
        if (!host) continue;
        grouped.set(host, [...(grouped.get(host) ?? []), card]);
      }

      for (const [host, group] of grouped) {
        const overlay = document.createElement('div');
        overlay.className = 'card-overlay';
        for (const card of group) overlay.append(card);
        host.append(overlay);

        host.classList.add('has-cards');
        host.setAttribute('role', 'button');
        host.setAttribute('tabindex', '0');
        host.setAttribute('aria-expanded', 'false');
        host.setAttribute(
          'aria-label',
          group.length === 1
            ? 'Show the psychology note for this image'
            : `Show the ${group.length} psychology notes for this image`
        );

        const toggle = () => {
          const isOpen = host.hasAttribute('data-cards-open');
          closeOpen();
          if (isOpen) return;
          host.setAttribute('data-cards-open', '');
          host.setAttribute('aria-expanded', 'true');
          openHost = host;
        };

        host.addEventListener('click', toggle);
        host.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          // Space would otherwise scroll the page.
          event.preventDefault();
          toggle();
        });

        hosts.push(host);
      }
    };

    const apply = () => {
      teardown();
      if (wide.matches) setupMargin();
      else setupOverlay();
      // With reduced motion there is nothing to ease, so cards in the margin
      // are simply shown rather than tied to scroll position.
      if (wide.matches && still.matches) {
        for (const card of cards) card.setAttribute('data-visible', '');
        observer?.disconnect();
        observer = null;
      }
    };

    apply();
    wide.addEventListener('change', apply);
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeOpen();
    });
  }

  // A looping autoplay is continuous motion, so a reduced-motion preference
  // stops it. The controls stay either way, which is also what satisfies
  // "pause, stop, hide" for moving content that starts on its own.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const video of document.querySelectorAll<HTMLVideoElement>('video[autoplay]')) {
      video.autoplay = false;
      video.pause();
    }
  }
</script>
