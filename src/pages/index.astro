---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TagList from '../components/TagList.astro';

const studies = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Zifu Lu — UX & Product Design">
  {/*
    The page leads with the illustration rather than a headline, but the
    document still needs exactly one h1 -- for screen readers, for search
    results, and so the heading outline is not missing its root.
  */}
  <h1 class="sr-only">Zifu Lu — UX and product design</h1>

  <section class="mx-auto max-w-4xl px-6 pt-8">
    {/*
      PLACEHOLDER. The flat export, dropped in so the shelf can be seen in
      place. Nothing here is interactive: the real treatment is this
      illustration under an invisible SVG hit-area overlay, per CLAUDE.md.

      The export carries roughly a third of empty canvas below the bottom
      shelf, so the frame crops it instead of leaving a gap. object-position:top
      is what decides that the crop comes off the bottom.
    */}
    <div class="aspect-[15/8] w-full overflow-hidden">
      <img
        src="/img/shelf-full.webp"
        width="2400"
        height="1799"
        alt="An illustrated bookshelf: three wooden shelves holding colorful books, storage boxes, and a potted plant."
        class="h-full w-full object-cover object-top"
        fetchpriority="high"
      />
    </div>
  </section>

  {/*
    id="work" is the jump target for the nav's /#work link and the "All work"
    link on case studies. scroll-mt keeps the heading off the viewport edge on
    arrival instead of butting against it.
  */}
  <section
    id="work"
    class="mx-auto mt-16 max-w-4xl scroll-mt-8 px-6"
    aria-labelledby="work-heading"
  >
    <h2 id="work-heading" class="m-0 text-2xl">Selected work</h2>

    <ul class="m-0 mt-8 list-none border-t border-line p-0">
      {
        studies.map((study) => (
          <li class="border-b border-line">
            {/*
              Grid rather than flex so the thumbnail column is a fixed track and
              the text column takes the rest. minmax(0,1fr) lets long words wrap
              instead of forcing the track wider.
            */}
            <a
              href={`/work/${study.id}`}
              class="group grid grid-cols-[5.5rem_minmax(0,1fr)] items-start gap-5 py-8 no-underline sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-8"
            >
              {/*
                alt="" on purpose: the project name is right beside it, and
                announcing "AdvisrLab" twice is worse than not at all.
                A square frame with object-cover means a square mark fills it
                edge to edge with no crop, while a wider screenshot thumbnail
                later will center-crop rather than letterbox.
              */}
              {/*
                No explicit width/height: Astro then uses the source's own
                dimensions. Asking for more than the source has would upscale --
                wasted bytes and no extra detail. CSS decides display size; the
                intrinsic attributes are only there to prevent layout shift.
              */}
              <Image
                src={study.data.thumbnail}
                alt=""
                class="aspect-square w-full rounded-lg object-cover"
              />

              <div>
                <h3 class="m-0 text-xl text-ink underline-offset-4 group-hover:underline group-focus-visible:underline">
                  {study.data.title}
                </h3>

                <p class="m-0 mt-2 max-w-xl text-ink-muted">{study.data.summary}</p>

                <TagList items={study.data.role} label="Roles" class="mt-4" />

                <p class="m-0 mt-3 text-[0.875rem] text-ink-muted">{study.data.timeline}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
