---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const studies = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Zifu Lu — UX & Product Design">
  {/*
    The page leads with the illustration rather than a headline, but the
    document still needs exactly one h1 -- for screen readers, for search
    results, and so the heading outline is not missing its root.
  */}
  <h1 class="sr-only">Zifu Lu — UX and product design</h1>

  <section class="mx-auto max-w-4xl px-6 pt-8">
    {/*
      PLACEHOLDER. The flat export, dropped in so the shelf can be seen in
      place. Nothing here is interactive: the real treatment is this
      illustration under an invisible SVG hit-area overlay, per CLAUDE.md.

      The export carries roughly a third of empty canvas below the bottom
      shelf, so the frame crops it instead of leaving a gap. object-position:top
      is what decides that the crop comes off the bottom.
    */}
    <div class="aspect-[15/8] w-full overflow-hidden">
      <img
        src="/img/shelf-full.webp"
        width="2400"
        height="1799"
        alt="An illustrated bookshelf: three wooden shelves holding colorful books, storage boxes, and a potted plant."
        class="h-full w-full object-cover object-top"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-4xl px-6" aria-labelledby="work-heading">
    <h2 id="work-heading" class="m-0 text-2xl">Selected work</h2>

    <ul class="m-0 mt-8 list-none border-t border-line p-0">
      {
        studies.map((study) => (
          <li class="border-b border-line">
            <a
              href={`/work/${study.id}`}
              class="group flex items-start gap-5 py-7 no-underline"
            >
              {study.data.logo && (
                /* alt="" on purpose: the project name is right beside it, and
                   announcing "AdvisrLab" twice is worse than not at all. */
                <Image
                  src={study.data.logo}
                  alt=""
                  width={128}
                  height={128}
                  class="mt-1 h-16 w-16 flex-none rounded-lg"
                />
              )}

              <div>
                <h3 class="m-0 text-xl text-ink underline-offset-4 group-hover:underline group-focus-visible:underline">
                  {study.data.title}
                </h3>
                <p class="m-0 mt-2 max-w-xl text-ink-muted">{study.data.summary}</p>
                <p class="m-0 mt-3 text-[0.875rem] text-ink-muted">
                  {study.data.role} · {study.data.timeline}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
