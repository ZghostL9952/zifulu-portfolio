---
import { Image } from 'astro:assets';

/**
 * Two-column row: prose in one column, a screenshot or video in the other.
 *
 * Pass `img` for the common case. For anything else (a video, several stacked
 * shots) leave `img` off and fill the `media` slot instead.
 *
 * Stacks to one column below 900px, text first, which is the order the content
 * reads in anyway.
 */
interface Props {
  img?: ImageMetadata;
  alt?: string;
  /** Which side the media sits on from 900px up. */
  media?: 'right' | 'left';
  /** Media column width: a phone capture, or something wider like a diagram. */
  size?: 'phone' | 'wide';
}

const { img, alt = '', media = 'right', size = 'phone' } = Astro.props;
---

<div class:list={['split', `split--${media}`, `split--${size}`]}>
  <div class="split-text"><slot /></div>

  <div class="split-media">
    {img ? <Image src={img} alt={alt} /> : <slot name="media" />}
  </div>
</div>

<style>
  .split {
    display: grid;
    gap: 1.5rem;
    margin: 1.75rem 0;
  }

  @media (min-width: 900px) {
    .split {
      align-items: start;
      gap: 2.5rem;
    }

    .split--phone {
      grid-template-columns: minmax(0, 1fr) 13rem;
    }

    .split--wide {
      grid-template-columns: minmax(0, 1fr) 21rem;
    }

    /* `order` rather than a reversed column list, so the DOM keeps text first
       and the reading order never depends on the visual arrangement. */
    .split--left .split-text {
      order: 2;
    }

    .split--left .split-media {
      order: 1;
    }
  }

  /* Beats `.prose[data-astro-cid] img` on specificity, which is what strips the
     auto margins the standalone-image rule would otherwise apply here. */
  .split .split-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 10px;
  }

  .split .split-media :global(figure) {
    margin: 0;
  }

  .split .split-media :global(video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  /* First element in the text column should not push the row down. */
  .split-text > :global(*:first-child) {
    margin-top: 0;
  }

  .split-text > :global(*:last-child) {
    margin-bottom: 0;
  }
</style>
