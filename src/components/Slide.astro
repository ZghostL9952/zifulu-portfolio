---
import { Image } from 'astro:assets';

/**
 * One carousel slide: prose on one side, a screenshot or video on the other.
 * Pass `img` for the common case, or fill the `media` slot for anything else.
 */
interface Props {
  img?: ImageMetadata;
  alt?: string;
}

const { img, alt = '' } = Astro.props;
---

<div class="slide" role="group" aria-roledescription="slide">
  <div class="slide-text"><slot /></div>

  <div class="slide-media">
    {img ? <Image src={img} alt={alt} /> : <slot name="media" />}
  </div>
</div>

<style>
  .slide {
    /* One slide per view, and the snap point the track aligns to. */
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding: 0.25rem 0.25rem 1rem;
  }

  @media (min-width: 900px) {
    .slide {
      grid-template-columns: minmax(0, 1fr) 13rem;
      gap: 2.5rem;
      align-items: start;
    }
  }

  .slide-text > :global(*:first-child) {
    margin-top: 0;
  }

  .slide-text > :global(*:last-child) {
    margin-bottom: 0;
  }

  /* Beats `.prose[data-astro-cid] img` on specificity, stripping the auto
     margins the standalone-image rule would otherwise apply. */
  .slide .slide-media :global(img),
  .slide .slide-media :global(video) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 10px;
  }

  .slide .slide-media :global(figure) {
    margin: 0;
  }

  /* The words arrive from the side as the slide lands.

     Gated on [data-enhanced], which the script sets: without JS no slide is
     ever marked active, so this must not be able to hide anything. */
  :global(.carousel[data-enhanced]) .slide-text {
    transition:
      opacity 320ms ease,
      transform 320ms ease;
  }

  :global(.carousel[data-enhanced] .slide:not([data-active])) .slide-text {
    opacity: 0;
    transform: translateX(1.75rem);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.carousel[data-enhanced]) .slide-text,
    :global(.carousel[data-enhanced] .slide:not([data-active])) .slide-text {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
