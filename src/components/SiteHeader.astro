---
const path = Astro.url.pathname;

const links = [
  { href: '/#work', label: 'Work', match: (p: string) => p === '/' || p.startsWith('/work') },
  { href: '/about', label: 'About', match: (p: string) => p.startsWith('/about') },
];
---

<header class="border-b border-line">
  <div class="mx-auto max-w-4xl px-6 py-5 flex items-baseline justify-between gap-6">
    <a
      href="/"
      class="font-display text-xl font-semibold text-ink no-underline"
      aria-label="Zifu Lu, home"
    >
      Zifu Lu
    </a>

    <nav aria-label="Main">
      <ul class="flex items-center gap-6 list-none m-0 p-0">
        {
          links.map((link) => {
            const isCurrent = link.match(path);
            return (
              /*
                The daisy sits in the li rather than inside the anchor so the
                hover underline stays under the word and does not run beneath
                the flower. alt="" because aria-current already tells a screen
                reader which page this is -- the daisy is the visual half of
                the same signal.
              */
              <li class="flex items-center gap-1.5">
                {isCurrent && (
                  <img src="/favicon.svg" alt="" width="16" height="16" class="flex-none" />
                )}
                <a
                  href={link.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class:list={[
                    'text-[0.9375rem] no-underline hover:underline underline-offset-4',
                    isCurrent ? 'text-ink font-medium' : 'text-ink-muted',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
