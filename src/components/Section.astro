---
/**
 * A case-study section. Wraps one `##` heading and its content.
 *
 * No visual styling of its own -- separation comes from the hairline the `h2`
 * already draws above itself. This exists to group content semantically and to
 * hold prose to a readable measure now that the column is wider.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={['case-section', className]}>
  <slot />
</section>

<style>
  .case-section {
    margin: 0;
  }

  /* Prose that runs the full width of a widened column gets uncomfortably long
     to read, so direct-child text is held to a sane measure. Anything inside a
     Split is exempt -- its own column already constrains it. */
  .case-section > :global(p),
  .case-section > :global(ul),
  .case-section > :global(ol) {
    max-width: 38rem;
  }

</style>
