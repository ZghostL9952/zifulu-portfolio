---
/**
 * A boxed case-study section. Wraps one `##` heading and its content.
 *
 * The outline is a 1px --line hairline, not a card: no shadow, no fill. That
 * keeps it inside the "hairline dividers only" rule while still reading as a
 * container.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={['case-section', className]}>
  <slot />
</section>

<style>
  .case-section {
    margin: 1.75rem 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 2.25rem 2.25rem 2.5rem;
  }

  /* Prose that runs the full width of a widened column gets uncomfortably long
     to read, so direct-child text is held to a sane measure. Anything inside a
     Split is exempt -- its own column already constrains it. */
  .case-section > :global(p),
  .case-section > :global(ul),
  .case-section > :global(ol) {
    max-width: 38rem;
  }

  @media (max-width: 640px) {
    .case-section {
      border-radius: 10px;
      padding: 1.5rem 1.25rem 1.75rem;
    }
  }
</style>
